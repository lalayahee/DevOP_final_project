# Example environment variables (DO NOT commit real secrets)

# Per-service MongoDB connection strings
USER_MONGO_URL=
PRODUCT_MONGO_URL=
ORDER_MONGO_URL=

# Order service needs to know the other service URLs when deployed
USER_URL=
PRODUCT_URL=

# Common
NODE_ENV=production
PORT=

# Example usage (local):
# USER_MONGO_URL=mongodb://localhost:27017/user_db
# PRODUCT_MONGO_URL=mongodb://localhost:27017/product_db
# ORDER_MONGO_URL=mongodb://localhost:27017/order_db
